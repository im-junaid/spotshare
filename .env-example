# --- Django Core Settings ---
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.up.railway.app

# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Local example (if using Docker or local Postgres):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spotshare_db

# --- Redis (Cache & Celery) ---
# Format: redis://default:PASSWORD@HOST:PORT
# Local example:
REDIS_URL=redis://127.0.0.1:6379/0

# --- Cloudinary (Media Storage) ---
# Copy this from your Cloudinary Dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email (Gmail SMTP) ---
EMAIL_HOST_USER=your-email@gmail.com
# Use a Google "App Password", NOT your regular Gmail password
EMAIL_HOST_PASSWORD=your-16-character-app-password

# --- Railway Specific (Optional for Local) ---
# This helps Django recognize the Railway domain for CSRF
RAILWAY_PUBLIC_URL=https://your-app-name.up.railway.app